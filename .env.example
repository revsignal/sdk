# Agentic Tagging Backend Configuration
# This file is for the BACKEND SERVER, not the client SDK
# Copy this file to .env and fill in your values

# ============================================
# REQUIRED: OpenAI Configuration
# ============================================
# Your OpenAI API key for AI-powered analysis
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use (default: gpt-4o)
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o

# ============================================
# Server Configuration
# ============================================
# Port for the backend server to listen on
PORT=3000

# Environment: development, staging, production
NODE_ENV=development

# ============================================
# Database Configuration
# ============================================
# Path to SQLite database file (relative or absolute)
DATABASE_PATH=./data.db

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins for CORS
# Use * for development, specific domains for production
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGINS=*

# ============================================
# Webhook Configuration (Optional)
# ============================================
# Enable webhook functionality
ENABLE_WEBHOOKS=true

# Webhook retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_TIMEOUT_MS=5000

# ============================================
# Analysis Configuration (Optional)
# ============================================
# Minimum interactions before triggering analysis
MIN_INTERACTIONS_FOR_ANALYSIS=10

# Time threshold (minutes) to force analysis
ANALYSIS_TIME_THRESHOLD_MINUTES=5

# Pattern detection threshold (minimum occurrences)
PATTERN_DETECTION_THRESHOLD=2

# ============================================
# Logging Configuration (Optional)
# ============================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable detailed request logging
ENABLE_REQUEST_LOGGING=true
