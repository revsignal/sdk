# Agentic Tagging Backend Configuration - V1
# Copy this file to .env and customize as needed

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# PostgreSQL connection string
# Format: postgresql://[user[:password]@][host][:port][/dbname]
DATABASE_URL=postgresql://localhost:5432/agentic_tagging

# ============================================
# Server Configuration
# ============================================
# Port for the backend server to listen on
PORT=3000

# Environment: development, production
NODE_ENV=development

# ============================================
# Security Configuration
# ============================================
# Demo mode - disables authentication (use for testing only)
DEMO_MODE=true

# Require authentication - set to true in production
REQUIRE_AUTH=false

# Write key for authentication (only needed if REQUIRE_AUTH=true)
# WRITE_KEY=your-secret-write-key

# Default customer ID (used when auth is disabled)
DEFAULT_CUSTOMER_ID=demo-customer

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins for CORS
# Use * for development, specific domains for production
# Example: https://example.com,https://app.example.com
ALLOWED_ORIGINS=*
